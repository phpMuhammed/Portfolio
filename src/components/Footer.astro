---
import type { SiteContent } from '../content/types';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-line dark:border-line-dark border-t">
  <div class="text-ink-soft dark:text-ink-dark-soft mx-auto max-w-[960px] px-5 py-6 text-sm">
    {content.identity.name} · {year}
  </div>
</footer>
