---
import Icon from './Icon.astro';
import { DESIGN_V2 } from '../config/design';
import type { SiteContent } from '../content/types';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { nav, identity } = content;

const navItems = [
  { id: 'work', label: nav.work },
  { id: 'skills', label: nav.skills },
  { id: 'about', label: nav.about },
  { id: 'contact', label: nav.contact },
];
---

<a
  href="#content"
  class="focus:bg-paper dark:focus:bg-paper-dark focus:text-ink dark:focus:text-ink-dark sr-only z-50 rounded-md px-4 py-2 focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:outline-2 focus:outline-offset-2 focus:outline-accent"
>
  {nav.skipToContent}
</a>

<header
  class="site-header border-line dark:border-line-dark bg-paper/90 dark:bg-paper-dark/90 sticky top-0 z-40 border-b backdrop-blur"
>
  <div class="mx-auto flex max-w-[960px] items-center justify-between gap-4 px-5 py-4">
    <a href={content.path} class="font-semibold tracking-tight">
      {identity.name}
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label={nav.menuLabel}>
      {
        navItems.map((item) => (
          <a
            href={`#${item.id}`}
            data-nav-link={item.id}
            class="text-ink-soft dark:text-ink-dark-soft hover:text-ink dark:hover:text-ink-dark text-sm font-medium transition-colors aria-[current=true]:text-accent dark:aria-[current=true]:text-accent-dark"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        id="lang-toggle"
        href={content.altPath}
        hreflang={content.htmlLangAlt}
        class="border-line dark:border-line-dark hover:border-accent dark:hover:border-accent-dark inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition-colors active:scale-95"
      >
        <Icon name="globe" class="h-4 w-4" />
        {nav.languageToggleLabel}
      </a>

      <button
        id="theme-toggle"
        type="button"
        class="border-line dark:border-line-dark hover:border-accent dark:hover:border-accent-dark inline-flex h-9 w-9 items-center justify-center rounded-full border transition-colors active:scale-90"
        aria-label={nav.themeToggleDarkLabel}
        data-light-label={nav.themeToggleLightLabel}
        data-dark-label={nav.themeToggleDarkLabel}
      >
        <Icon name="sun" class="hidden h-4 w-4 dark:block" />
        <Icon name="moon" class="block h-4 w-4 dark:hidden" />
      </button>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="border-line dark:border-line-dark inline-flex h-9 w-9 items-center justify-center rounded-full border md:hidden"
        aria-label={nav.menuLabel}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="h-4 w-4" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="border-line dark:border-line-dark hidden flex-col gap-1 border-t px-5 py-3 md:hidden"
    aria-label={nav.menuLabel}
  >
    {
      navItems.map((item) => (
        <a href={`#${item.id}`} data-nav-link={item.id} class="text-ink-soft dark:text-ink-dark-soft rounded-md px-2 py-2 text-sm font-medium">
          {item.label}
        </a>
      ))
    }
  </nav>

  {DESIGN_V2 && <div class="scroll-progress" aria-hidden="true" />}
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  if (themeToggle) {
    themeToggle.setAttribute(
      'aria-label',
      root.classList.contains('dark')
        ? themeToggle.dataset.lightLabel || ''
        : themeToggle.dataset.darkLabel || ''
    );
  }

  themeToggle?.addEventListener('click', () => {
    const isDark = root.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    themeToggle.setAttribute(
      'aria-label',
      isDark ? themeToggle.dataset.lightLabel || '' : themeToggle.dataset.darkLabel || ''
    );
  });

  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('flex');
    mobileMenu?.classList.toggle('hidden');
    mobileToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  mobileMenu?.querySelectorAll('a[data-nav-link]').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      mobileMenu.classList.remove('flex');
      mobileToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  const langToggle = document.getElementById('lang-toggle') as HTMLAnchorElement | null;
  langToggle?.addEventListener('click', (event) => {
    event.preventDefault();
    const sections = document.querySelectorAll('main section[id]');
    let currentId = '';
    let minDistance = Infinity;
    sections.forEach((section) => {
      const rect = section.getBoundingClientRect();
      if (rect.top <= 140 && Math.abs(rect.top) < minDistance) {
        minDistance = Math.abs(rect.top);
        currentId = section.id;
      }
    });
    const base = langToggle.getAttribute('href') || '/';
    window.location.href = currentId ? `${base}#${currentId}` : base;
  });

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));

  if (sections.length && navLinks.length) {
    const linkForId = (id: string) =>
      Array.from(navLinks).find((link) => link.dataset.navLink === id);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = linkForId(entry.target.id);
          if (!link) return;
          if (entry.isIntersecting) {
            navLinks.forEach((l) => l.setAttribute('aria-current', l === link ? 'true' : 'false'));
          } else if (link.getAttribute('aria-current') === 'true') {
            link.setAttribute('aria-current', 'false');
          }
        });
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
    );

    sections.forEach((section) => observer.observe(section));
  }

  // v2 only — the progress hairline is not rendered when DESIGN_V2 is off.
  const progress = document.querySelector<HTMLElement>('.scroll-progress');
  const header = document.querySelector<HTMLElement>('.site-header');

  if (progress && header) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? window.scrollY / scrollable : 0;
      progress.style.setProperty('--progress', String(Math.min(1, Math.max(0, ratio))));
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );

    update();
  }
</script>
