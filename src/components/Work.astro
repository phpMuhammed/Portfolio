---
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';
import type { SiteContent } from '../content/types';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { work } = content;
---

<section id="work" class="mx-auto max-w-[960px] px-5 py-16 md:py-24">
  <h2 class="reveal text-3xl font-bold tracking-tight md:text-4xl">{work.heading}</h2>

  <div class="mt-10 flex flex-col gap-8 md:mt-14 md:gap-10">
    {
      work.entries.map((entry, index) => (
        <article
          style={`--fade-delay: ${Math.min(index, 3) * 80}ms`}
          class:list={[
            'motion-safe-fade card-shadow spotlight-card border-line dark:border-line-dark bg-paper-raised dark:bg-paper-dark-raised rounded-2xl border p-6 shadow-sm md:p-8',
            entry.flagship && 'ring-accent/30 dark:ring-accent-dark/30 md:p-10 ring-1',
          ]}
        >
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex items-start gap-4">
              <LogoMark slug={entry.slug} name={entry.name} accentColor={entry.accentColor} class={entry.flagship ? 'h-16 w-16' : 'h-14 w-14'} />
              <div>
                <h3 class:list={['font-bold tracking-tight', entry.flagship ? 'text-2xl md:text-3xl' : 'text-xl md:text-2xl']}>
                  {entry.name}
                </h3>
                <p class="text-ink-soft dark:text-ink-dark-soft mt-1 text-sm font-medium">{entry.role}</p>
                {entry.subLabel && <p class="text-ink-soft dark:text-ink-dark-soft mt-0.5 text-xs">{entry.subLabel}</p>}
                <p class="mt-1 font-mono text-xs text-ink-soft dark:text-ink-dark-soft">
                  <bdi dir="ltr">{entry.dates}</bdi>
                </p>
              </div>
            </div>

            {entry.metricBadge && (
              <span
                dir="ltr"
                class="text-accent dark:text-accent-dark border-accent/30 dark:border-accent-dark/30 shrink-0 rounded-full border bg-accent/5 px-4 py-2 font-mono text-sm font-semibold dark:bg-accent-dark/10"
              >
                {entry.metricBadge}
              </span>
            )}
          </div>

          <p class="mt-5 max-w-[70ch] leading-relaxed">{entry.description}</p>

          <ul class="mt-5 flex flex-col gap-2.5">
            {entry.highlights.map((highlight) => (
              <li class="flex gap-3 leading-relaxed">
                <span class="bullet text-accent dark:text-accent-dark mt-1 select-none" aria-hidden="true">
                  &#8226;
                </span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>

          <div class="mt-6 flex flex-wrap gap-2">
            {entry.techTags.map((tag) => (
              <span class="border-line dark:border-line-dark rounded-full border px-3 py-1 font-mono text-xs">{tag}</span>
            ))}
          </div>

          {(entry.website || entry.linkedin) && (
            <div class="mt-6 flex flex-wrap gap-3">
              {entry.website && (
                <a
                  href={entry.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={entry.websiteLinkLabel}
                  class="border-line dark:border-line-dark hover:border-accent dark:hover:border-accent-dark inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors active:scale-95"
                >
                  <Icon name="external-link" class="h-4 w-4" />
                  {work.websiteLabel}
                </a>
              )}
              {entry.linkedin && (
                <a
                  href={entry.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={entry.linkedinLinkLabel}
                  class="border-line dark:border-line-dark hover:border-accent dark:hover:border-accent-dark inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors active:scale-95"
                >
                  <Icon name="linkedin" class="h-4 w-4" />
                  {work.linkedinLabel}
                </a>
              )}
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.spotlight-card');
  cards.forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--spot-x', `${event.clientX - rect.left}px`);
      card.style.setProperty('--spot-y', `${event.clientY - rect.top}px`);
    });
  });
</script>
